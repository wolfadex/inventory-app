database module Backend exposing
    ( User
    , UserID
    , AuthInfo
    , endpoint login
    , SignUpInfo
    , endpoint signup
    , endpoint logout
    , endpoint getUserSelf
    --
    , OrganizationID
    , Organization
    , CreateOrganizationInput
    , endpoint createOrganization
    --
    , Item
    , UnitType(..)
    , UnitStyle(..)
    , ImperialVolumeUnit(..)
    , MetricVolumeUnit(..)
    , ImperialMassUnit(..)
    , MetricMassUnit(..)
    , AddItemInput
    , endpoint addItem
    , endpoint getItems
    , GetItemInput
    , endpoint getItem
    , UpdateItemInput
    , endpoint updateItem
    , DeleteItemInput
    , endpoint softDeleteItem
    , endpoint softUndeleteItem
    , endpoint hardDeleteItem
    )

import Cookies exposing (Cookies)
import Rows exposing (..)
import Security exposing (Unrestricted(..))
import Sequence as Seq exposing (Sequence)
import Table exposing (..)
import Password
import Time exposing (Unit(..))
import Transaction exposing (succeed)
import Uuid exposing (Uuid)


--------------------------------------------------------------------------------
-- INVENTORY MANAGEMENT --------------------------------------------------------
--------------------------------------------------------------------------------


type alias Item =
    { id : ItemID
    , name : String
    -- , quantity : Float32
    , unitType : UnitType
    , unitStyle : UnitStyle
    , imperialVolumeUnit : ImperialVolumeUnit
    , metricVolumeUnit : MetricVolumeUnit
    , imperialMassUnit : ImperialMassUnit
    , metricMassUnit : MetricMassUnit
    , owningOrganization : OrganizationID
    , createdOn : Time.Posix
    , createdBy : UserID
    , lastModifiedOn : Time.Posix
    , lastModifiedBy : UserID
    , deletedOn : Maybe Time.Posix
    , deletedBy : Maybe UserID
    }


type UnitType
    = Metric
    | Imperial


type UnitStyle
    = Volume
    | Mass
    | Count

type ImperialVolumeUnit
    = Gallon
    | Quart
    | Pint
    | Cup
    | FluidOunce
    | Tablespoon
    | Teaspoon

type ImperialMassUnit
    = Pound
    | Ounce


type MetricVolumeUnit
    = Liter
    | Milliliter

type MetricMassUnit
    = Kilogram
    | Gram


type ItemID = ItemID Uuid


items : Table ( OrganizationID, Permission ) Item
items :=
    table
        { primary = .id
        , security =
            Security.policy
                { access = \( organizationID, permission ) item -> permission.read && item.owningOrganization == organizationID
                , insert = \( organizationID, permission ) item -> permission.create && item.owningOrganization == organizationID
                , update = \( organizationID, permission ) item -> permission.update && item.owningOrganization == organizationID
                , remove = \( organizationID, permission ) item -> permission.delete && item.owningOrganization == organizationID
                }
        }


type alias AddItemInput =
    { organizationID: OrganizationID
    , name : String
    -- , quantity : Float32
    , unitType : UnitType
    , unitStyle : UnitStyle
    , imperialVolumeUnit : ImperialVolumeUnit
    , metricVolumeUnit : MetricVolumeUnit
    , imperialMassUnit : ImperialMassUnit
    , metricMassUnit : MetricMassUnit
    }


addItem : Cookies -> AddItemInput -> Transaction Item
addItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
        id := Uuid.uuid |> Transaction.map ItemID
        now := Time.now

        () :=
            insert items ( input.organizationID, role.item )
                { id = id
                , name = input.name
                -- , quantity = input.quantity
                , unitType = input.unitType
                , unitStyle = input.unitStyle
                , imperialVolumeUnit = input.imperialVolumeUnit
                , metricVolumeUnit = input.metricVolumeUnit
                , imperialMassUnit = input.imperialMassUnit
                , metricMassUnit = input.metricMassUnit
                , owningOrganization = input.organizationID
                , createdOn = now
                , createdBy = user.id
                , lastModifiedOn = now
                , lastModifiedBy = user.id
                , deletedOn = Nothing
                , deletedBy = Nothing
                }
    in
    access items ( input.organizationID, role.item )
        |> select


getItems : Cookies -> OrganizationID -> Transaction (Rows Item)
getItems cookies organizationID =
    let
        user := requireUser cookies
        role := requireRole ( user.id, organizationID )
    in
    access items ( organizationID, role.item )
        |> selectAll


type alias GetItemInput =
    { itemID : ItemID
    , organizationID : OrganizationID
    }


getItem : Cookies -> GetItemInput -> Transaction Item
getItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
    in
    access items ( input.organizationID, role.item )
        |> filter (\item -> item.id == input.itemID)
        |> select


type alias UpdateItemInput =
    { id : ItemID
    , name : String
    -- , quantity : Float32
    , unitType : UnitType
    , unitStyle : UnitStyle
    , organizationID : OrganizationID
    }


updateItem : Cookies -> UpdateItemInput -> Transaction ()
updateItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
        now := Time.now
    in
    update items ( input.organizationID, role.item )
        (\item -> item.id == input.id)
        (\item ->
            { item
                | name = input.name
                -- , quantity = input.quantity
                , unitType = input.unitType
                , unitStyle = input.unitStyle
                , lastModifiedOn = now
                , lastModifiedBy = user.id
            }
        )


type alias DeleteItemInput =
    { id : ItemID
    , organizationID : OrganizationID
    }


softDeleteItem : Cookies -> DeleteItemInput -> Transaction ()
softDeleteItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
        now := Time.now
    in
    update items ( input.organizationID, role.item )
        (\item -> item.id == input.id)
        (withDeleted user.id now)


softUndeleteItem : Cookies -> DeleteItemInput -> Transaction ()
softUndeleteItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
        now := Time.now
    in
    update items ( input.organizationID, role.item )
        (\item -> item.id == input.id)
        (withUndeleted user.id now)


hardDeleteItem : Cookies -> DeleteItemInput -> Transaction ()
hardDeleteItem cookies input =
    let
        user := requireUser cookies
        role := requireRole ( user.id, input.organizationID )
    in
    remove items ( input.organizationID, role.item )
        (\item -> item.id == input.id)

--------------------------------------------------------------------------------
-- COMMON ----------------------------------------------------------------------
--------------------------------------------------------------------------------

type alias Traceable a =
    { a
        | createdOn : Time.Posix
        , createdBy : UserID
        , lastModifiedOn : Time.Posix
        , lastModifiedBy : UserID
        , deletedOn : Maybe Time.Posix
        , deletedBy : Maybe UserID
    }


withModified : UserID -> Time.Posix -> Traceable a -> Traceable a
withModified userID now traceable =
    { traceable
        | lastModifiedOn = now
        , lastModifiedBy = userID
    }


withDeleted : UserID -> Time.Posix -> Traceable a -> Traceable a
withDeleted userID now traceable =
    { traceable
        | lastModifiedOn = now
        , lastModifiedBy = userID
        , deletedOn = Just now
        , deletedBy = Just userID
    }


withUndeleted : UserID -> Time.Posix -> Traceable a -> Traceable a
withUndeleted userID now traceable =
    { traceable
        | lastModifiedOn = now
        , lastModifiedBy = userID
        , deletedOn = Nothing
        , deletedBy = Nothing
    }


--------------------------------------------------------------------------------
-- SESSION MANAGEMENT ----------------------------------------------------------
--------------------------------------------------------------------------------


-- PERMISSIONS


type alias Permission =
    { create : Bool
    , read : Bool
    , update : Bool
    , delete : Bool
    }

allPermission : Permission
allPermission =
    { create = True
    , read = True
    , update = True
    , delete = True
    }


readOnlyPermission : Permission
readOnlyPermission =
    { create = False
    , read = True
    , update = False
    , delete = False
    }


type alias Role =
    { id : RoleID
    , item : Permission
    , organization : Permission
    , organizationUsers : Permission
    }


enableAllRoles : RoleID -> Role
enableAllRoles roleId =
    { id = roleId
    , item = allPermission
    , organization = allPermission
    , organizationUsers = allPermission
    }


type RoleID = RoleID Uuid


roles : Table Permission Role
roles :=
    table
        { primary = .id
        , security =
            Security.policy
                { access = \permission _ -> permission.read
                , insert = \permission _ -> permission.create
                , update = \permission _ -> permission.update
                , remove = \permission _ -> permission.delete
                }
        }


requireRole : ( UserID, OrganizationID ) -> Transaction Role
requireRole ( userID, organizationID ) =
    let
        orgUser :=
            access organizationUsers readOnlyPermission
                |> select
    in
    access roles readOnlyPermission
        |> filter (\role -> role.id == orgUser.roleID)
        |> select

-- ORGANIZATIONS TABLE


type alias Organization =
    { id : OrganizationID
    , owner : UserID
    , name : String
    , createdOn : Time.Posix
    , createdBy : UserID
    , lastModifiedOn : Time.Posix
    , lastModifiedBy : UserID
    , deletedOn : Maybe Time.Posix
    , deletedBy : Maybe UserID
    }


type OrganizationID = OrganizationID Uuid


organizations : Table Permission Organization
organizations :=
    table
        { primary = .id
        , security =
            Security.policy
                { access = \permission _ -> permission.read
                , insert = \permission _ -> permission.create
                , update = \permission _ -> permission.update
                , remove = \permission _ -> permission.delete
                }
        }


type alias OrganizationUsers =
    { organizationID : OrganizationID
    , userID : UserID
    , roleID : RoleID
    , createdOn : Time.Posix
    , createdBy : UserID
    , lastModifiedOn : Time.Posix
    , lastModifiedBy : UserID
    , deletedOn : Maybe Time.Posix
    , deletedBy : Maybe UserID
    }


organizationUsers : Table Permission OrganizationUsers
organizationUsers :=
    table
        { primary = \orgUser -> ( orgUser.organizationID, orgUser.userID )
        , security =
            Security.policy
                { access = \permission _ -> permission.read
                , insert = \permission _ -> permission.create
                , update = \permission _ -> permission.update
                , remove = \permission _ -> permission.delete
                }
        }

type alias CreateOrganizationInput =
    { name : String
    }

createOrganization : Cookies -> CreateOrganizationInput -> Transaction Organization
createOrganization cookies newOrgData =
    let
        user := requireUser cookies

        orgId := Uuid.uuid |> Transaction.map OrganizationID

        now := Time.now

        () :=
            insert organizations { create = True, read = False, update = False, delete = False }
                { id = orgId
                , owner = user.id
                , name = newOrgData.name
                , createdOn = now
                , createdBy = user.id
                , lastModifiedOn = now
                , lastModifiedBy = user.id
                , deletedOn = Nothing
                , deletedBy = Nothing
                }

        roleId := Uuid.uuid |> Transaction.map RoleID

        () :=
            insert roles { create = True, read = False, update = False, delete = False }
                (enableAllRoles roleId)

        () :=
            insert organizationUsers { create = True, read = False, update = False, delete = False }
                { organizationID = orgId
                , userID = user.id
                , roleID = roleId
                , createdOn = now
                , createdBy = user.id
                , lastModifiedOn = now
                , lastModifiedBy = user.id
                , deletedOn = Nothing
                , deletedBy = Nothing
                }
    in
    access organizations (readOnlyPermission)
        |> filter (\org -> org.id == orgId)
        |> select



-- USERS TABLE


type alias UserRow =
    { id : UserID
    , pw_hash : Password.Hash
    , primaryEmail : String
    , name : String
    , unitType : UnitType
    --
    , createdOn : Time.Posix
    , createdBy : UserID
    , lastModifiedOn : Time.Posix
    , lastModifiedBy : UserID
    , deletedOn : Maybe Time.Posix
    , deletedBy : Maybe UserID
    }


type UserID = UserID Uuid


users : Table SuperUser UserRow
users :=
    table
        { primary = .id
        , security = superUser
        }

type alias User =
    { id : UserID
    , primaryEmail : String
    , name : String
    , unitType : UnitType
    --
    , createdOn : Time.Posix
    , createdBy : UserID
    , lastModifiedOn : Time.Posix
    , lastModifiedBy : UserID
    , deletedOn : Maybe Time.Posix
    , deletedBy : Maybe UserID
    }

userToUserRow : UserRow -> User
userToUserRow user =
    { id = user.id
    , primaryEmail = user.primaryEmail
    , name = user.name
    , unitType = user.unitType
    , createdOn = user.createdOn
    , createdBy = user.createdBy
    , lastModifiedOn = user.lastModifiedOn
    , lastModifiedBy = user.lastModifiedBy
    , deletedOn = user.deletedOn
    , deletedBy = user.deletedBy
    }


getUserSelf : Cookies -> Transaction ( User, Maybe Organization )
getUserSelf cookies =
    let
        user := requireUser cookies

        maybeOrgUser :=
            access organizationUsers readOnlyPermission
                |> filter (\orgUsers -> orgUsers.userID == user.id)
                |> limitBy .organizationID 1
                |> selectMaybe
    in
    case maybeOrgUser of
        Nothing ->
            succeed ( user, Nothing )

        Just orgUser ->
            access organizations readOnlyPermission
                |> filter (\org -> org.id == orgUser.organizationID)
                |> selectMaybe
                |> Transaction.map (\organization -> ( user, organization))

-- SESSIONS TABLE


type alias Session =
    { cookie : Uuid
    , userID : UserID
    , expires : Time.Posix
    }


sessions : Table SuperUser Session
sessions :=
    table
        { primary = .cookie
        , security = superUser
        }



-- SUPER USER POLICY


type SuperUser = SuperUser


superUser : Security.Policy SuperUser row
superUser =
    Security.policy
        { access = \SuperUser _ -> True
        , insert = \SuperUser _ -> True
        , update = \SuperUser _ -> True
        , remove = \SuperUser _ -> True
        }

--------------------------------------------------------------------------------
-- SESSION ENDPOINTS -----------------------------------------------------------
--------------------------------------------------------------------------------

type alias AuthInfo =
    { email : String
    , password : String
    }

login : Cookies -> AuthInfo -> Transaction Cookies.Header
login _ authData =
    let
        existingUser :=
            access users SuperUser
                |> filter (\u -> u.primaryEmail == authData.email && Password.verify u.pw_hash authData.password)
                |> selectMaybe
    in
    case existingUser of
        Nothing ->
            Transaction.fail

        Just user ->
            let
                created := Time.now
                uuid := Uuid.uuid

                () :=
                    insert sessions SuperUser
                        { cookie = uuid
                        , userID = user.id
                        , expires = Time.plus 15 Minutes created
                        }
            in
            succeed (toCookie uuid)


type alias SignUpInfo =
    { name : String
    , email : String
    , password : String
    }

signup : Cookies -> SignUpInfo -> Transaction Cookies.Header
signup _ authData =
    let
        existingUser :=
            access users SuperUser
                |> filter (\u -> u.primaryEmail == authData.email && Password.verify u.pw_hash authData.password)
                |> selectMaybe
    in
    case existingUser of
        Nothing ->
            let
                userID  := Uuid.uuid |> Transaction.map UserID
                now := Time.now
                uuid    := Uuid.uuid
                hash    := Password.bcrypt authData.password

                () :=
                    insert users SuperUser
                        { id = userID
                        , pw_hash = hash
                        , primaryEmail = authData.email
                        , name = authData.name
                        , unitType = Imperial
                        , createdOn = now
                        , createdBy = userID
                        , lastModifiedOn = now
                        , lastModifiedBy = userID
                        , deletedOn = Nothing
                        , deletedBy = Nothing
                        }

                () :=
                    insert sessions SuperUser
                        { cookie = uuid
                        , expires = Time.plus 15 Minutes now
                        , userID = userID
                        }

                orgId := Uuid.uuid |> Transaction.map OrganizationID

                () :=
                    insert organizations { create = True, read = False, update = False, delete = False }
                        { id = orgId
                        , owner = userID
                        , name = authData.name
                        , createdOn = now
                        , createdBy = userID
                        , lastModifiedOn = now
                        , lastModifiedBy = userID
                        , deletedOn = Nothing
                        , deletedBy = Nothing
                        }

                roleId := Uuid.uuid |> Transaction.map RoleID

                () :=
                    insert roles { create = True, read = False, update = False, delete = False }
                        (enableAllRoles roleId)

                () :=
                    insert organizationUsers { create = True, read = False, update = False, delete = False }
                        { organizationID = orgId
                        , userID = userID
                        , roleID = roleId
                        , createdOn = now
                        , createdBy = userID
                        , lastModifiedOn = now
                        , lastModifiedBy = userID
                        , deletedOn = Nothing
                        , deletedBy = Nothing
                        }
            in
            succeed (toCookie uuid)

        Just _ ->
            Transaction.fail

-- LOGOUT


logout : Cookies -> Transaction Cookies.Header
logout cookies =
    case fromCookie cookies of
        Nothing ->
            succeed (Cookies.remove "u")

        Just uuid ->
            let
                () := remove sessions SuperUser (\s -> s.cookie == uuid)
            in
            succeed (Cookies.remove "u")



-- COOKIES


toCookie : Uuid -> Cookies.Header
toCookie uuid =
    Cookies.set "u" (Uuid.toBase64 uuid) 15 Minutes


fromCookie : Cookies -> Maybe Uuid
fromCookie cookies =
    Cookies.get cookies "u" Uuid.fromBase64



-- TABLE SECURITY


requireUser : Cookies -> Transaction User
requireUser cookies =
    case fromCookie cookies of
        Just uuid ->
            let
                time := Time.now
            in
            access sessions SuperUser
                |> filter (\s -> s.cookie == uuid && time < s.expires)
                |> map .userID
                |> select
                |> Transaction.andThen
                    (\userID ->
                        access users SuperUser
                            |> filter (\u -> u.id == userID)
                            |> map userToUserRow
                            |> select
                    )

        Nothing ->
            Transaction.fail
