{
    "name": "inventory-app",
    "author": "Wolfgang Schuster",
    "scripts": {
        "dev": "run-pty run-pty.json",
        "dev:elm": "elm-watch hot",
        "dev:css": "css-in-elm watch public/styles.css src/Css.elm",
        "dev:review": "elm-review --watch --fix",
        "dev:acadia:make": "acadia make --generate-elm-endpoints=gen",
        "dev:acadia:serve": "acadia serve --html=public/index.html"
    },
    "devDependencies": {
        "@ryannhg/css-in-elm": "^1.0.0",
        "elm": "^0.19.1-6",
        "elm-format": "^0.8.8",
        "elm-watch": "^2.0.0-beta.7",
        "run-pty": "^5.0.0"
    },
    "volta": {
        "node": "22.21.0"
    }
}
